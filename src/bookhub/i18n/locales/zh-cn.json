  "text.rules.help.step.take_between_texts": "- take_between_texts：取两标记之间文本",
  "text.rules.help.step.take_bracket_content": "- take_bracket_content：提取第 N 个括号内容",
  "text.rules.help.step.take_line": "- take_line：从 TXT 开头文本中提取第 N 行",
  "text.rules.help.step.take_first_lines": "- take_first_lines：从 TXT 开头文本中提取前 N 行",
